    docSignatures: {
        type: Object,
        default: () => ({}),
    },
    // true = mode preview untuk penandatangan (tanpa opsi cetak)
    previewMode: {
        type: Boolean,
        default: false,
    },
});

const selectedTanggal = ref(props.tanggal);
const divisi = ref('PKS');
const departemen = ref('Pabrik');
const periode = ref('');

// Penandatangan default sesuai foto fisik
